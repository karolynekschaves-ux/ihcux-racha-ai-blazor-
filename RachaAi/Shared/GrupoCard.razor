@using RachaAi.Models

<div class="list-group-item list-group-item-action border-0 mb-2 rounded shadow-sm p-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <small class="text-muted d-block" style="font-size: 0.75rem;">@Grupo.Categoria</small>
            <span class="fw-bold text-dark">@Grupo.Name</span>
        </div>
        
        <div class="text-end">
            <small class="text-muted d-block" style="font-size: 0.75rem;">
                @(Grupo.NoVermelho ? "Você deve" : "Você recebe")
            </small>
            <span class="fw-bold @(Grupo.NoVermelho ? "text-secondary" : "text-secondary")">
                @Grupo.ValorPendente.ToString("C2")
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Grupos Grupo { get; set; } = new();
}